PORT=3000

DATABASE_URL=postgres://pia_do_sul:pia_do_sul@localhost:5433/pia_do_sul

JWT_SECRET=change-me
# Longo de propósito para o MVP: o app do associado ainda não tem refresh token (ver
# mobile/src/features/auth/auth-context.tsx), então o token de login precisa durar bastante pra
# não derrubar a sessão sozinho. O painel web não é afetado pela duração aqui — o cookie que
# guarda o token já expira em 24h por conta própria (ver frontend-web/src/lib/auth-token.ts).
JWT_EXPIRES_IN=365d

# Usado só por `npm run seed:admin` (cria o primeiro usuário administrador para login local)
SEED_ADMIN_EMAIL=diretoria@piadosul.org.br
SEED_ADMIN_SENHA=mudar123

# Ver T-BE-006 (TCC-FINAL/aplicacoes/PLANEJAMENTO-GERAL.md) — pendência de quantos dias após o
# vencimento o lembrete de inadimplência dispara; mantido configurável até validar com a entidade.
INADIMPLENCIA_LEMBRETE_DIAS=5
